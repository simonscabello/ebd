APP_NAME=EBD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# Dados da igreja exibidos na interface
EBD_CHURCH_NAME="Segunda Igreja Batista em Barcelona"
# Fuso usado para calcular "hoje", a próxima aula e a leitura do dia
EBD_TIMEZONE=Europe/Madrid
# Permite que qualquer pessoa crie conta. Novas contas não entram em nenhuma
# classe automaticamente: um professor/admin adiciona o membro à classe.
EBD_REGISTRATION_ENABLED=true
# Disco (config/filesystems.php) onde ficam os materiais enviados.
# Use "local" em desenvolvimento e "s3" para S3/R2/MinIO.
EBD_MATERIALS_DISK=local
# Link pessoal dos alunos: dias que o aparelho fica conectado e validade do
# link (vazio = vale até o professor gerar outro ou bloquear).
EBD_ACCESS_LINK_REMEMBER_DAYS=400
EBD_ACCESS_LINK_TTL_DAYS=
# "Alunos que precisam de atenção": faltas seguidas e dias sem leitura.
EBD_RISK_MISSED_MEETINGS=2
EBD_RISK_INACTIVE_DAYS=10

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dentro do Docker, DB_HOST/REDIS_HOST/MAIL_HOST são sobrescritos pelo compose.yaml.
# Os valores abaixo funcionam ao rodar comandos direto na máquina host.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ebd
DB_USERNAME=ebd
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (http://localhost:8025) captura os e-mails em desenvolvimento
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ebd@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage compatível com S3 (AWS S3, Cloudflare R2, MinIO...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Portas publicadas pelo Docker Compose
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_MAILPIT_UI_PORT=8025
# UID/GID do usuário dentro do container (use `id -u` / `id -g` no Linux)
DOCKER_UID=1000
DOCKER_GID=1000
